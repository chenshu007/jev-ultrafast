# Fill once; TYPE_TEXT falls back to this key. Never commit .env.
AI_GATEWAY_API_KEY=
# Alternative: mount a Docker secret and set this path (see docs/nas.md).
AI_GATEWAY_API_KEY_FILE=
JEV_PROVIDER=vercel
JEV_MODEL=typesafe-ai/jev
JEV_ADAPTER_URL=http://gateway-adapter:8767
TYPESAFE_API_KEY=
TYPESAFE_API_KEY_FILE=
TYPESAFE_MODEL=jev-latest
TEXT_MODEL_API_KEY=
TEXT_MODEL_API_KEY_FILE=
TEXT_MODEL_BASE_URL=https://ai-gateway.vercel.sh/v1
TEXT_MODEL=openai/gpt-5.4-nano
TEXT_MODEL_REASONING=none
# Chromium and Jev share one container: CDP is loopback only.
BU_CDP_URL=http://127.0.0.1:9222
TYPESAFE_DEMO_PORT=8766
JEV_HOST=0.0.0.0
# Required: the actual NAS LAN IP. No wildcard or public binding.
NAS_LAN_IP=
JEV_PUBLIC_ORIGIN=
